# ==============================================================================
# DISCOVER HIDDEN MOROCCO - ENTERPRISE HOSTINGER / LITESPEED / APACHE CONFIG
# ==============================================================================

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Canonical domain: remove www
  RewriteCond %{HTTP_HOST} ^www\.discoverhiddenmorocco\.com$ [NC]
  RewriteRule ^ https://discoverhiddenmorocco.com%{REQUEST_URI} [L,R=301]

  # 3. Canonical redirects
  RewriteRule ^testimonials/?$ /reviews [R=301,L,NC]
  RewriteRule ^tours?/?$ /destinations [R=301,L,NC]
  RewriteRule ^experiences?/?$ /destinations [R=301,L,NC]
  RewriteRule ^explore/?$ /destinations [R=301,L,NC]

  # 4. Redirect direct request for index.html -> /
  RewriteCond %{THE_REQUEST} /index(\.html)?[\s?] [NC]
  RewriteRule ^index(\.html)?$ / [R=301,L]

  # 5. External request with .html -> 301 redirect to clean URL
  RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
  RewriteRule ^ /%1 [NC,L,R=301]

  # 6. Skip rewriting if the requested path is already a real directory or file
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 7. Image fallback: if requested under images/ but file is in root, serve from root
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1 -f
  RewriteRule ^images/(?:.+/)?([^/]+\.(?:jpe?g|png|gif|webp|svg|ico|avif))$ /$1 [NC,L]

  # 7b. Reverse Image fallback: if requested in root but file is under images/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/images/$1 -f
  RewriteRule ^([^/]+\.(?:jpe?g|png|gif|webp|svg|ico|avif))$ /images/$1 [NC,L]

  # 8. Internally map clean URL to .html file (with both DOCUMENT_ROOT and relative fallbacks)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*?)/?$ /$1.html [NC,L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*?)/?$ /$1.html [NC,L,QSA]
</IfModule>

# Fallback error document
ErrorDocument 404 /404.html

# ------------------------------------------------------------------------------
# Performance: Gzip Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain image/svg+xml application/javascript application/x-javascript application/json application/xml font/woff font/woff2 font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# ------------------------------------------------------------------------------
# Performance: Brotli Compression
# ------------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript text/xml text/plain image/svg+xml application/javascript application/x-javascript application/json application/xml font/woff font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# Performance: Browser Caching & Zero-Lag Live Updates
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/x-javascript "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # 1. Force all HTML files to NEVER cache so visitors get fresh updates on refresh
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 2. Kill Service Worker caching permanently
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 3. CSS & JS: Always revalidate so edits update instantly
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>

  # 4. Media & Fonts: Cache smoothly
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|woff2|woff|ttf|otf|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
